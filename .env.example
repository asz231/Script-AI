# Script AI Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==============================================
# SERVER CONFIG
# ==============================================
PORT=3000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==============================================
# N8N WEBHOOK URLS
# These are the ONLY place secrets should live
# ==============================================

# Webhook for channel analysis (main)
N8N_ANALYZE_WEBHOOK=http://localhost:5678/webhook/YOUR-ANALYZE-WEBHOOK-ID/chat

# Webhook for script generation (can be same as analyze or separate workflow)
N8N_SCRIPT_WEBHOOK=http://localhost:5678/webhook/YOUR-SCRIPT-WEBHOOK-ID/chat

# Webhook for ideas refresh (optional — falls back to analyze webhook)
N8N_IDEAS_WEBHOOK=

# ==============================================
# OPTIONAL: Future Auth / Premium Features
# ==============================================
# JWT_SECRET=your-super-secret-jwt-key
# DATABASE_URL=your-database-url
# STRIPE_SECRET_KEY=your-stripe-key
